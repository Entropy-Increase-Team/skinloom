      "additionalProperties": false,
      "properties": {
        "database": {
          "additionalProperties": false,
          "properties": {
            "required": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "executable": {
          "description": "Relative POSIX base path of the native Go binary (e.g. bin/my-plugin).",
          "type": "string"
        },
        "httpProxy": {
          "default": false,
          "description": "Enable local Unix socket / loopback reverse proxy for streaming HTTP/WebSocket routes.",
          "type": "boolean"
        },
        "platforms": {
          "items": {
            "pattern": "^[a-z0-9]+/[a-z0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "protocolVersion": {
          "default": 1,
          "enum": [
            1
          ],
          "type": "integer"
        }
      },
      "required": [
        "executable"
      ],
      "type": "object"
    },
    "optionalDependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "permissions": {
      "items": {
        "enum": [
          "admin.ui",
          "auth.password",
          "auth.provider",
          "captcha.provider",
          "cdn.provider",
          "closet.write",
          "cron",
          "http.fetch",
          "http.stream",
          "mail.send",
          "native.exec",
          "notify.send",
          "players.read",
          "players.write",
          "provider.render",
          "provider.search",
          "provider.storage",
          "routes.public",
          "score.write",
          "storage.docs",
          "storage.files",
          "storage.kv",
          "storage.sql",
          "textures.read",
          "textures.write",
          "users.ban",
          "users.read",
          "users.write",
          "yggdrasil.extend"
        ],
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "repository": {
      "type": "string"
    },
    "routes": {
      "additionalProperties": false,
      "properties": {
        "public": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "runtime": {
      "default": "js",
      "description": "Execution tier: 'js' (QuickJS/WASM sandbox) or 'native' (isolated Go gRPC subprocess).",
      "enum": [
        "js",
        "native"
      ],
      "type": "string"
    },
    "screenshot": {
      "description": "Relative path to a preview image in the package.",
      "type": "string"
    },
    "server": {
      "description": "Relative path to bundled ES2023 server entry (e.g. server.js).",
      "type": "string"
    },
    "services": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "settings": {
      "$ref": "#/definitions/settingsMap"
    },
    "slots": {
      "items": {
        "enum": [
          "site.header.actions",
          "site.footer",
          "site.banner",
          "auth.login.below",
          "auth.login.providers",
          "auth.register.below",
          "auth.register.providers",
          "auth.captcha.widget",
          "user.dashboard.widgets",
          "user.profile.sections",
          "user.player.actions",
          "user.closet.item.actions",
          "skinlib.card.badges",
          "skinlib.detail.sidebar",
          "skinlib.detail.below",
          "skinlib.upload.below",
          "admin.dashboard.widgets",
          "admin.user.actions",
          "admin.user.tabs",
          "admin.texture.actions",
          "admin.status.cards"
        ],
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "storage": {
      "additionalProperties": false,
      "properties": {
        "collections": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "indexes": {
                "additionalProperties": {
                  "enum": [
                    "string",
                    "string:unique",
                    "number",
                    "time"
                  ],
                  "type": "string"
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "type": "object"
        },
        "quota": {
          "additionalProperties": false,
          "properties": {
            "docs": {
              "minimum": 1,
              "type": "integer"
            },
            "filesBytes": {
              "minimum": 1,
              "type": "integer"
            },
            "kvKeys": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "theme": {
      "additionalProperties": false,
      "properties": {
        "colorScheme": {
          "default": "both",
          "enum": [
            "both",
            "light",
            "dark"
          ],
          "type": "string"
        },
        "css": {
          "type": "string"
        },
        "home": {
          "items": {
            "$ref": "#/definitions/block"
          },
          "type": "array"
        },
        "layout": {
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "auth": {
              "enum": [
                "card",
                "split"
              ],
              "type": "string"
            },
            "site": {
              "enum": [
                "topnav",
                "sidebar"
              ],
              "type": "string"
            },
            "skinlib": {
              "enum": [
                "comfortable",
                "compact"
              ],
              "type": "string"
            },
            "texture": {
              "enum": [
                "split",
                "stacked"
              ],
              "type": "string"
            },
            "user": {
              "enum": [
                "sidebar",
                "tabs"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "overrides": {
          "items": {
            "enum": [
              "site.header",
              "site.footer",
              "site.logo",
              "auth.background",
              "home.hero",
              "texture.card",
              "player.card"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "settings": {
          "$ref": "#/definitions/settingsMap"
        },
        "tokens": {
          "additionalProperties": false,
          "properties": {
            "dark": {
              "$ref": "#/definitions/colorTokens"
            },
            "fonts": {
              "additionalProperties": {
                "type": "string"
              },
              "properties": {
                "display": {
                  "type": "string"
                },
                "mono": {
                  "type": "string"
                },
                "sans": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "light": {
