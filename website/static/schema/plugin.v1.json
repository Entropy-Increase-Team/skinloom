  "description": "Auto-generated by internal/tools/plugingen. Manifest file (plugin.json) for SkinLoom plugins and themes.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "enum": [
        1
      ],
      "type": "integer"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "blocks": {
      "additionalProperties": {
        "additionalProperties": true,
        "properties": {
          "defaultProps": {
            "type": "object"
          },
          "name": {
            "$ref": "#/definitions/localizedString"
          }
        },
        "type": "object"
      },
      "type": "object"
    },
    "dependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "description": {
      "$ref": "#/definitions/localizedString"
    },
    "engines": {
      "additionalProperties": false,
      "properties": {
        "go": {
          "description": "Minimum Go toolchain version for native plugins (e.g. \u003e=1.26).",
          "type": "string"
        },
        "skinloom": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "extends": {
      "description": "Parent theme ID for single-level theme inheritance (ADR 0043).",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "type": "string"
    },
    "forms": {
      "additionalProperties": false,
      "properties": {
        "auth.login": {
          "items": {
            "$ref": "#/definitions/formDef"
          },
          "type": "array"
        },
        "auth.register": {
          "items": {
            "$ref": "#/definitions/formDef"
          },
          "type": "array"
        },
        "player.create": {
          "items": {
            "$ref": "#/definitions/formDef"
          },
          "type": "array"
        },
        "texture.upload": {
          "items": {
            "$ref": "#/definitions/formDef"
          },
          "type": "array"
        },
        "user.profile": {
          "items": {
            "$ref": "#/definitions/formDef"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "homepage": {
      "type": "string"
    },
    "hooks": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "items": {
            "oneOf": [
              {
                "enum": [
                  "closet.added",
                  "closet.removed",
                  "player.created",
                  "player.deleted",
                  "player.renamed",
                  "player.updated",
                  "report.resolved",
                  "report.submitted",
                  "score.changed",
                  "settings.changed",
                  "texture.deleted",
                  "texture.updated",
                  "texture.uploaded",
                  "user.banned",
                  "user.deleted",
                  "user.loggedIn",
                  "user.registered",
                  "user.updated",
                  "yggdrasil.joined"
                ],
                "type": "string"
              },
              {
                "pattern": "^plugin:[a-z0-9-]+\\.[a-zA-Z0-9._-]+$",
                "type": "string"
              }
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "filter": {
          "items": {
            "enum": [
              "closet.itemName",
              "player.name",
              "profile.textures",
              "score.checkinAmount",
              "texture.name",
              "user.badges",
              "yggdrasil.profileProperties"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "guard": {
          "items": {
            "enum": [
              "auth.login",
              "auth.register",
              "closet.add",
              "closet.remove",
              "closet.rename",
              "player.create",
              "player.delete",
              "player.rename",
              "player.textures.clear",
              "player.textures.set",
              "report.submit",
              "score.checkin",
              "texture.delete",
              "texture.rename",
              "texture.type",
              "texture.upload",
              "texture.visibility",
              "user.avatar.update",
              "user.profile.update",
              "yggdrasil.authenticate",
              "yggdrasil.join"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "http": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "description": "Declared outbound HTTPS/HTTP hostnames or *.domain patterns allowed for ctx.fetch.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxBodyBytes": {
          "maximum": 10485760,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "icon": {
      "description": "Relative asset path or icon name.",
      "type": "string"
    },
    "id": {
      "description": "Unique identifier (kebab-case: plugins 3-40 chars, themes 1-32 chars).",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "plugin",
        "theme"
      ],
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "menus": {
      "items": {
        "$ref": "#/definitions/menuDef"
      },
      "type": "array"
    },
    "name": {
      "$ref": "#/definitions/localizedString"
    },
