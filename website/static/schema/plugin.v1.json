                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "version": {
      "description": "Semantic version (e.g. 1.0.0).",
      "type": "string"
    },
    "web": {
      "description": "Relative path to bundled ESM web entry (e.g. web/index.js).",
      "type": "string"
    }
