{
  "$schema": "https://skinloom.cn/schema/plugin.v1.json",
  "id": "default",
  "kind": "theme",
  "version": "0.1.0",
  "name": { "zh-CN": "云织默认主题", "en": "SkinLoom Default" },
  "description": {
    "zh-CN": "SkinLoom 自带主题，按主题标准编写，可作为自制主题的起点。",
    "en": "The built-in theme, written against the theme standard; a starting point for your own."
  },
  "license": "MIT",
  "engines": { "skinloom": ">=0.1.0" },
  "apiVersion": 1,
  "theme": {
    "tokens": {
      "light": {
        "background": "oklch(0.99 0.004 247)",
        "foreground": "oklch(0.21 0.03 264)",
        "card": "oklch(1 0 0)",
        "card-foreground": "oklch(0.21 0.03 264)",
        "popover": "oklch(1 0 0)",
        "popover-foreground": "oklch(0.21 0.03 264)",
        "primary": "oklch(0.58 0.16 252)",
        "primary-foreground": "oklch(0.99 0.01 247)",
        "secondary": "oklch(0.96 0.01 252)",
        "secondary-foreground": "oklch(0.28 0.04 264)",
        "muted": "oklch(0.96 0.008 252)",
        "muted-foreground": "oklch(0.52 0.03 257)",
        "accent": "oklch(0.94 0.03 230)",
        "accent-foreground": "oklch(0.28 0.04 264)",
        "destructive": "oklch(0.58 0.22 27)",
        "border": "oklch(0.91 0.012 252)",
        "input": "oklch(0.91 0.012 252)",
        "ring": "oklch(0.58 0.16 252)",
        "radius": "0.75rem",
        "brand-gradient": "linear-gradient(135deg, oklch(0.62 0.15 240), oklch(0.66 0.14 200))"
      },
      "dark": {
        "background": "oklch(0.17 0.02 262)",
        "foreground": "oklch(0.95 0.01 252)",
        "card": "oklch(0.21 0.025 262)",
        "card-foreground": "oklch(0.95 0.01 252)",
        "popover": "oklch(0.21 0.025 262)",
        "popover-foreground": "oklch(0.95 0.01 252)",
        "primary": "oklch(0.70 0.14 245)",
        "primary-foreground": "oklch(0.18 0.03 262)",
        "secondary": "oklch(0.27 0.03 262)",
        "secondary-foreground": "oklch(0.95 0.01 252)",
        "muted": "oklch(0.27 0.03 262)",
        "muted-foreground": "oklch(0.72 0.03 257)",
        "accent": "oklch(0.30 0.04 245)",
        "accent-foreground": "oklch(0.95 0.01 252)",
        "destructive": "oklch(0.66 0.2 22)",
        "border": "oklch(1 0 0 / 10%)",
        "input": "oklch(1 0 0 / 14%)",
        "ring": "oklch(0.70 0.14 245)",
        "brand-gradient": "linear-gradient(135deg, oklch(0.45 0.12 245), oklch(0.40 0.10 205))"
      },
      "fonts": {
        "sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif"
      }
    },
    "css": "theme.css",
    "layout": { "site": "topnav", "auth": "card", "user": "sidebar", "skinlib": "comfortable" },
    "home": [
      { "type": "hero", "props": { "primaryAction": "/skinlib", "secondaryAction": "/auth/register" } },
      { "type": "announcement" },
      { "type": "features" },
      { "type": "launcher-guide" }
    ]
  }
}
