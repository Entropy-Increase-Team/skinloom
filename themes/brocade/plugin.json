    "css": "theme.css",
    "layout": {
      "auth": "split",
      "skinlib": "compact"
    },
    "home": [
      {
        "type": "hero",
        "props": {
          "primaryAction": "/skinlib",
          "secondaryAction": "/auth/register"
        }
      },
      {
        "type": "announcement"
      },
      {
        "type": "latest-textures",
        "props": {
          "limit": 12
        }
      },
      {
        "type": "stats"
      },
      {
        "type": "launcher-guide"
      }
    ]
  }
