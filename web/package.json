{
  "name": "skinloom-web-workspace",
  "private": true,
  "description": "SkinLoom frontend workspace. bun is the primary package manager (bun.lock); pnpm and npm work as fallbacks.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.30.1"
    }
  },
  "scripts": {
    "dev": "node scripts/ws.mjs dev --only @skinloom/web",
    "build": "node scripts/ws.mjs build --only @skinloom/web",
    "typecheck": "node scripts/ws.mjs typecheck",
    "test": "node --test scripts/ws.test.mjs && node scripts/ws.mjs test",
    "gen:api": "node scripts/ws.mjs generate --only @skinloom/api-client"
  }
}
