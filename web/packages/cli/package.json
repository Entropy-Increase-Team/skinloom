{
  "name": "@skinloom/cli",
  "version": "1.1.3",
  "description": "CLI toolkit (skinloom-plugin) for building, linting, dev-reloading, packing, and signing SkinLoom plugins and themes.",
  "license": "MIT",
  "homepage": "https://docs.skinloom.cn/docs/plugins/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entropy-Increase-Team/skinloom.git",
    "directory": "web/packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Entropy-Increase-Team/skinloom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "skinloom-plugin": "./bin/skinloom-plugin.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "esbuild src/cli.ts src/index.ts --bundle --format=esm --platform=node --target=node22 --external:esbuild --outdir=dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@skinloom/plugin-sdk": "*",
    "esbuild": "^0.28.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "react": "19.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
