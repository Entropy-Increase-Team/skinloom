    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "orval": "~8.43.0",
    "react": "19.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
