{
  "name": "create-skinloom-plugin",
  "version": "1.1.3",
  "description": "Scaffolding CLI (npm create skinloom-plugin) for SkinLoom plugins and themes.",
  "license": "MIT",
  "homepage": "https://docs.skinloom.cn/docs/plugins/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entropy-Increase-Team/skinloom.git",
    "directory": "web/packages/create-plugin"
  },
  "bugs": {
    "url": "https://github.com/Entropy-Increase-Team/skinloom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "create-skinloom-plugin": "./bin/create-skinloom-plugin.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "esbuild src/cli.ts src/index.ts --bundle --format=esm --platform=node --target=node22 --outdir=dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@skinloom/cli": "*",
    "@types/node": "^24",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
