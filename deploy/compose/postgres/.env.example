# Copy to .env and change before the first start.
DB_PASSWORD=change-me
# SKINLOOM_VERSION=latest    # a release such as 1.1.3, or "edge" for the main branch
# Default registry is Docker Hub (dnyo666/skinloom-server & dnyo666/skinloom-web).
# Uncomment the two lines below to pull from GHCR instead:
# SKINLOOM_SERVER_IMAGE=ghcr.io/entropy-increase-team/server
# SKINLOOM_WEB_IMAGE=ghcr.io/entropy-increase-team/web
# SKINLOOM_BIND=0.0.0.0      # set to 127.0.0.1 when behind a host reverse proxy (Nginx/Caddy/1Panel)
# SKINLOOM_PORT=17546        # host port
# TZ=Asia/Shanghai
