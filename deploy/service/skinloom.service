# systemd unit for a SkinLoom release bundle unpacked to /opt/skinloom.
#
#   sudo useradd --system --home /opt/skinloom --shell /usr/sbin/nologin skinloom
#   sudo chown -R skinloom:skinloom /opt/skinloom
#   sudo cp /opt/skinloom/service/skinloom.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now skinloom
#   journalctl -u skinloom | grep setup      # one-time setup link (first start)
#
# Another directory? Replace every /opt/skinloom below.
[Unit]
Description=SkinLoom (云织) Minecraft skin site
Documentation=https://skinloom.cn
After=network-online.target
Wants=network-online.target
# If the database runs on this host, start after it:
# After=network-online.target mariadb.service postgresql.service

[Service]
Type=simple
User=skinloom
Group=skinloom
WorkingDirectory=/opt/skinloom
ExecStart=/opt/skinloom/skinloom up --data /opt/skinloom/data
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

# Hardening. The frontend (Node.js) needs JIT, so MemoryDenyWriteExecute stays off.
NoNewPrivileges=true
ProtectSystem=strict
# data/ holds the database, config and uploads; .next/ the frontend's render cache.
ReadWritePaths=/opt/skinloom/data /opt/skinloom/web/apps/web/.next
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
